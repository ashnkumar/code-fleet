# CodeFleet configuration. Copy to `.env` and edit; every value below is the
# default the code uses when the variable is unset, so an empty file behaves
# exactly like this one. Nothing here is a secret except ANTHROPIC_API_KEY, and
# nothing is read from anywhere this file does not list.

# Where the coordination server binds. Loopback on purpose: there is no
# authentication, and the fleet is assumed to be one operator on one machine.
CODEFLEET_HOST=127.0.0.1
CODEFLEET_PORT=8099

# The SQLite file. Everything the fleet knows lives here, including the event
# log a finished run is replayed from.
CODEFLEET_DB=./codefleet.db

# The shared working tree the agents edit. `codefleet demo` ignores this and
# copies the demo repository into a fresh directory instead.
CODEFLEET_WORKDIR=./examples/demo-repo

# How many agent slots `codefleet run` starts.
CODEFLEET_RUNNERS=3

# The model each agent session uses. Haiku is the default because the demo graph
# is small work and the point being made is about coordination, not capability.
CODEFLEET_MODEL=claude-haiku-4-5-20251001

# Per-task wall clock, in seconds. Enforced by the runner around the session, and
# again by the server at `assigned_at + timeout + 60s` so a wedged runner that is
# still heartbeating cannot hold a task forever.
CODEFLEET_TASK_TIMEOUT=600

# Per-task spend cap handed to the SDK as `max_budget_usd`, and the turn cap
# beside it. Together with the wall clock these bound one attempt on three axes.
CODEFLEET_TASK_BUDGET_USD=0.50
CODEFLEET_MAX_TURNS=40

# Liveness. The stale threshold is four missed beats: past it the server marks the
# agent offline, releases its leases and requeues its task.
CODEFLEET_HEARTBEAT_INTERVAL=5
CODEFLEET_STALE_AFTER=20

# How often a runner asks for an assignment, and how often the scheduler sweeps.
# The tick loop also wakes immediately on any write that could create readiness,
# so this interval is the safety net rather than the latency.
CODEFLEET_POLL_INTERVAL=1
CODEFLEET_TICK_INTERVAL=0.5

# Attempts per task before it goes `failed` with `attempts_exhausted`, taking its
# dependents to `blocked_upstream`. Per-task overridable in the task graph.
CODEFLEET_MAX_ATTEMPTS=3

# Where `codefleet demo` puts each run's workspace, database and per-runner
# stderr, one timestamped directory per run; `codefleet run` writes its per-runner
# stderr straight into it. This is the one setting with no command-line flag, so
# the environment is the only way to move it.
CODEFLEET_RUN_DIR=./runs

# Guards `POST /reset`, which truncates every table. Unset means forbidden.
# CODEFLEET_ALLOW_RESET=1

# Read by the Claude Agent SDK, not by CodeFleet. Only `codefleet demo --dry-run`
# and the test suite work without it.
ANTHROPIC_API_KEY=
